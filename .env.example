# ---------- App ----------
PORT=3000
LOG_FORMAT=json     # json | text
LOG_LEVEL=info      # fatal | error | warn | info | debug | trace

# ---------- PostgreSQL ----------
# runtime: role sem UPDATE/DELETE no ledger
DATABASE_URL=postgres://wagering_app:app@localhost:5432/wagering
# migrations: dono do schema
DATABASE_MIGRATION_URL=postgres://wagering_owner:owner@localhost:5432/wagering
# active debug do mikro_orm
MIKRO_ORM_DEBUG=true
# ---------- Testes ----------
TEST_DATABASE_ADMIN_URL=postgres://wagering_owner:owner@localhost:5432/postgres
TEST_DATABASE_APP_URL=postgres://wagering_app:app@localhost:5432/postgres

# ---------- SQS (LocalStack) ----------
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_RECEIVE_COUNT=5
SQS_SHUTDOWN_TIMEOUT_MS=20000

# ---------- Outbox relay ----------
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_MS=30000
OUTBOX_IDLE_INTERVAL_MS=500

# ---------- Referências fora de ordem ----------
PENDING_REFERENCE_BACKOFF_BASE_MS=1000
PENDING_REFERENCE_BACKOFF_MAX_MS=60000
PENDING_REFERENCE_TTL_MS=900000

# ---------- Scheduler de pendências ----------
SCHEDULER_BATCH_SIZE=20
SCHEDULER_LEASE_MS=10000
SCHEDULER_IDLE_INTERVAL_MS=500